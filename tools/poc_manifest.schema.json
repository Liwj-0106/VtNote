{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtnote.local/schemas/poc-manifest-v1.json",
  "title": "VtNote authorized live POC manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "content_authorization",
    "billing_authorization",
    "provider_authorizations",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "content_authorization": {
      "$ref": "#/$defs/contentAuthorization"
    },
    "billing_authorization": {
      "$ref": "#/$defs/billingAuthorization"
    },
    "provider_authorizations": {
      "$ref": "#/$defs/providerAuthorizations"
    },
    "samples": {
      "type": "array",
      "minItems": 30,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "approvalBase": {
      "type": "object",
      "properties": {
        "acknowledged": { "const": true },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 },
        "approved_at": { "type": "string", "format": "date-time" }
      },
      "required": ["acknowledged", "approved_by", "approved_at"]
    },
    "contentAuthorization": {
      "allOf": [
        { "$ref": "#/$defs/approvalBase" },
        {
          "type": "object",
          "properties": {
            "rights_statement": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500
            }
          },
          "required": ["rights_statement"]
        }
      ],
      "unevaluatedProperties": false
    },
    "billingAuthorization": {
      "allOf": [
        { "$ref": "#/$defs/approvalBase" },
        {
          "type": "object",
          "properties": {
            "maximum_cny": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": ["maximum_cny"]
        }
      ],
      "unevaluatedProperties": false
    },
    "providerRevision": {
      "type": "object",
      "properties": {
        "connection_id": { "type": "string", "format": "uuid" },
        "profile_revision": { "type": "integer", "minimum": 1 },
        "attested_at": { "type": "string", "format": "date-time" }
      },
      "required": ["connection_id", "profile_revision", "attested_at"]
    },
    "providerAuthorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tencent_asr", "aliyun_bailian"],
      "properties": {
        "tencent_asr": {
          "allOf": [
            { "$ref": "#/$defs/providerRevision" },
            {
              "type": "object",
              "properties": {
                "upload_consent_revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["upload_consent_revision"]
            }
          ],
          "unevaluatedProperties": false
        },
        "aliyun_bailian": {
          "allOf": [
            { "$ref": "#/$defs/providerRevision" },
            {
              "type": "object",
              "properties": {
                "text_consent_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "workspace_region": { "const": "beijing" }
              },
              "required": ["text_consent_revision", "workspace_region"]
            }
          ],
          "unevaluatedProperties": false
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_kind",
        "source_ref",
        "language",
        "duration_band",
        "subtitle_kind",
        "audio_conditions",
        "planned_routes",
        "content_authorized",
        "login_required",
        "drm_protected",
        "network"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "source_kind": {
          "enum": ["bilibili", "youtube", "local_media"]
        },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "language": { "enum": ["mandarin", "english", "mixed"] },
        "duration_band": { "enum": ["3_10m", "10_40m", "40_120m"] },
        "subtitle_kind": { "enum": ["manual", "automatic", "none"] },
        "audio_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["clear_speech", "background_music", "accent", "overlap"]
          }
        },
        "planned_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "platform_subtitle",
              "tencent_inline",
              "tencent_cos",
              "local_asr",
              "translation",
              "notes",
              "recovery"
            ]
          }
        },
        "content_authorized": { "const": true },
        "login_required": { "const": false },
        "drm_protected": { "const": false },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "operator", "captured_at", "direct_only"],
          "properties": {
            "region": { "type": "string", "minLength": 1, "maxLength": 80 },
            "operator": { "type": "string", "minLength": 1, "maxLength": 120 },
            "captured_at": { "type": "string", "format": "date-time" },
            "direct_only": { "const": true }
          }
        }
      }
    }
  }
}
